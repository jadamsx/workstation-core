{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--viewport-size",
        "1440x900",
        "--image-responses",
        "omit"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0"
      ],
      "env": {}
    }
  }
}
