{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CI": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "GIT_EDITOR": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(launchctl *)",
      "Bash(git fetch*)",
      "Bash(git push*)",
      "Bash(git worktree*)",
      "Bash(herdr *)",
      "Bash(ps *)",
      "Bash(shell-reap *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker inspect*)",
      "Bash(git init*)",
      "Bash(git config*)",
      "Bash(git clone*)",
      "Bash(workstation-build *)",
      "Bash(~/.local/share/workstation/build/install.sh *)",
      "Bash(git -C * worktree*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * pull*)",
      "Bash(git -C * push*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Bash(git clean *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(kubectl --context*prod* *)",
      "Bash(kubectl * --context*prod*)",
      "Bash(docker system prune*)"
    ],
    "ask": [
      "Bash(glab mr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/pre-commit-guard.py"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/pre-push-guard.py"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/rm-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/env-file-guard.py"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/drafts-layout-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_navigate|mcp__playwright__browser_type|mcp__playwright__browser_fill_form|mcp__playwright__browser_evaluate|mcp__playwright__browser_file_upload",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/shared-env-guard.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/agent-model-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/notes-lint-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/project-context.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __HOME__/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "autoCompactWindow": 300000,
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "herdr *",
      "ps *",
      "shell-reap *",
      "gh *",
      "launchctl *",
      "git fetch*",
      "git push*",
      "git pull*",
      "git clone*",
      "git ls-remote*",
      "git init*",
      "git config*",
      "git worktree*",
      "workstation-build *",
      "~/.local/share/workstation/build/install.sh *",
      "git -C * worktree*",
      "git -C * fetch*",
      "git -C * pull*",
      "git -C * push*",
      "git -C * ls-remote*",
      "git -C * clone*",
      "git -C * init*",
      "git -C * config*"
    ],
    "filesystem": {
      "allowWrite": [
        "~/notes",
        "~/drafts",
        "~/.cache",
        "~/.npm",
        "~/Library/Caches",
        "~/.local/state",
        "**/.git",
        "~/.gitconfig",
        "~/.config/git",
        "~/.local/share/uv",
        "~/.local/share/workstation"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ],
      "denyWrite": [
        "~/.ssh",
        "**/.git/hooks"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "gitlab.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "ghcr.io",
        "docker.io",
        "*.docker.io",
        "localhost",
        "127.0.0.1"
      ]
    }
  },
  "x-workstation": {
    "ownedKeys": [
      "permissions",
      "effortLevel",
      "autoCompactWindow",
      "modelSettings",
      "env",
      "statusLine",
      "attribution",
      "sandbox"
    ],
    "ownedHookPath": "/.claude/hooks/",
    "foreignHookMarkers": [
      "herdr-agent-state",
      "context-mode-cache-heal"
    ]
  }
}
