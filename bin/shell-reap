#!/usr/bin/env python3
"""Usage: shell-reap <pid>

Stops a stuck shell: SIGTERM, then SIGKILL after 5 seconds if it is still alive. Refuses, with one line and exit 1,
anything that is not a shell (bash, zsh, sh) running under a claude process, and the caller's own shell chain.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import ReportsError, stop_shell  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) != 1 or not argv[0].isdigit():
        print(__doc__.splitlines()[0], file=sys.stderr)
        return 2
    try:
        stop_shell(int(argv[0]), wait=True)
    except ReportsError as err:
        print(f"shell-reap: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
