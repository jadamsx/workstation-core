#!/usr/bin/env python3
"""Usage: manager-start <name> --prompt "<text>" [--dir <path>]
       manager-start --check

Opens a manager tab (`herdr-manager start`) and submits the prompt once its agent is idle.
--check prints `coordinator` and exits 0 when this pane is the registered coordinator of its space, and exits 1
otherwise (a manager, or not in herdr), so a skill can decide whether to hand off.
"""
import argparse
import json
import os
import subprocess
import sys
from contextlib import suppress
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import INPUT_BOX, ReportsError, close_manager, herdr, pane_text, space_dir  # noqa: E402

READY_TIMEOUT_MS = "120000"


def is_coordinator() -> bool:
    pane = os.environ.get("HERDR_PANE_ID")
    registered = space_dir() / "coordinator"
    return bool(pane) and registered.exists() and registered.read_text().strip() == pane


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="manager-start")
    parser.add_argument("name", nargs="?")
    parser.add_argument("--prompt")
    parser.add_argument("--dir", default=os.getcwd())
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args(argv)
    try:
        if args.check:
            if not is_coordinator():
                return 1
            print("coordinator")
            return 0
    except (ReportsError, subprocess.CalledProcessError):
        return 1
    if not args.name or not args.prompt:
        parser.error("a name and --prompt are required")
    try:
        started = subprocess.run([str(Path(__file__).resolve().parent / "herdr-manager"), "start", args.name, "--dir", args.dir])
        if started.returncode:
            return started.returncode
        folder = space_dir() / args.name
        pane = json.loads((folder / "manager.json").read_text())["pane_id"]
        try:
            try:
                herdr("agent", "wait", pane, "--until", "idle", "--timeout", READY_TIMEOUT_MS)
            except subprocess.CalledProcessError:
                if not INPUT_BOX.search(pane_text(pane)):
                    raise
            herdr("agent", "prompt", pane, args.prompt)
        except Exception:
            with suppress(subprocess.CalledProcessError, OSError):
                close_manager(folder)
            raise
    except ReportsError as err:
        print(f"manager-start: {err}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as err:
        print(f"manager-start: {' '.join(err.cmd[:3])} failed: {err.stderr.strip()}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
