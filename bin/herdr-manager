#!/usr/bin/env python3
"""Usage: herdr-manager register | start <name> [--resume <session-id>] [--dir <path>] | list

Three-tier work: the coordinator session registers its pane, each manager runs in its own tab of the same
herdr space, and herdr-report-watch carries the manager's result files to the coordinator.

register  run in the coordinator's pane and renames its tab `◆ lead`; re-run after a handoff and reports follow
          the new pane.
start     opens a tab named `▸ <name>` running `claude --model sonnet` with the manager brief, and
          WORKSTATION_REPORTS pointing at the folder the manager writes result-<timestamp>.md into.
list      the managers of this space, whether their pane is alive, and their newest result file.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from contextlib import suppress
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import (  # noqa: E402
    INPUT_BOX, LEAD_TAB, MANAGER_TAB, NAME, TRUST_DIALOG, ReportsError, herdr, live_panes, pane_text, space_dir, wait_for_pane, wait_for_shell, write_atomic,
)

BRIEF = Path(__file__).resolve().parent.parent / "claude/templates/manager-brief.md"
SHELL_TIMEOUT = 20
STARTUP_TIMEOUT = 20
START_RETRIES = 3
SESSION_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def register() -> int:
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        raise ReportsError("not inside herdr: HERDR_PANE_ID is unset")
    path = space_dir() / "coordinator"
    write_atomic(path, pane + "\n")
    mine = next((p for p in herdr("pane", "list").get("panes", []) if p["pane_id"] == pane), None)
    if mine is None:
        raise ReportsError(f"pane {pane} is not in the herdr pane list")
    herdr("tab", "rename", mine["tab_id"], LEAD_TAB)
    print(f"coordinator {pane} -> {path}")
    return 0


def accept_trust_dialog(pane: str, directory: Path, blocked: bool = False) -> None:
    """Answer Claude Code's folder-trust prompt, but only for folders under the coordinator's own directory."""
    if blocked:
        text = pane_text(pane)
        if TRUST_DIALOG not in text:
            tail = "\n".join(text.splitlines()[-5:])
            raise ReportsError(f"the agent in pane {pane} is blocked during startup and no trust dialog is visible:\n{tail}")
    else:
        text = wait_for_pane(pane, lambda t: TRUST_DIALOG in t or INPUT_BOX.search(t), STARTUP_TIMEOUT)
        if text is None or TRUST_DIALOG not in text:
            return
    cwd = Path.cwd().resolve()
    if directory != cwd and cwd not in directory.parents:
        raise ReportsError(f"Claude Code does not trust {directory} and it is outside {cwd}; run claude there once to trust it")
    keys = ["Enter"] if re.search(r"❯\s*(1\.\s*)?Yes", text) else ["Down", "Enter"]
    herdr("agent", "send-keys", pane, *keys)
    if wait_for_pane(pane, INPUT_BOX.search, STARTUP_TIMEOUT) is None:
        raise ReportsError(f"the input box in pane {pane} never appeared after trusting {directory}")


def agent_start(name: str, pane: str, claude_args: list[str]) -> bool:
    """`herdr agent start`, retried while herdr still reports the new pane busy; True if it started blocked on a prompt."""
    for attempt in range(START_RETRIES + 1):
        try:
            herdr("agent", "start", name, "--kind", "claude", "--pane", pane, "--", *claude_args)
            return False
        except subprocess.CalledProcessError as err:
            output = f"{err.stderr}{err.stdout}"
            if "agent_not_ready" in output:
                return True
            if "agent_pane_busy" not in output or attempt == START_RETRIES:
                raise
            time.sleep(float(os.environ.get("AGENT_START_RETRY_SECONDS", "2")))
    return False


def start(name: str, resume: str | None, directory: str) -> int:
    if not NAME.fullmatch(name):
        raise ReportsError(f"name must match {NAME.pattern}: {name!r}")
    if resume and not SESSION_ID.fullmatch(resume):
        raise ReportsError(f"--resume needs a session id, got {resume!r}")
    reports = space_dir() / name
    reports.mkdir(parents=True, exist_ok=True)
    directory = Path(directory).resolve()
    tab = herdr(
        "tab", "create", "--workspace", os.environ["HERDR_WORKSPACE_ID"], "--cwd", str(directory),
        "--label", MANAGER_TAB + name, "--env", f"WORKSTATION_REPORTS={reports}", "--env", "DISABLE_AUTO_UPDATE=true", "--no-focus",
    )
    pane = tab["root_pane"]["pane_id"]
    claude_args = ["--model", "sonnet", *(["--resume", resume] if resume else []), "--append-system-prompt-file", str(BRIEF)]
    try:
        if not wait_for_shell(pane, SHELL_TIMEOUT):
            raise ReportsError(f"the shell in pane {pane} never settled")
        blocked = agent_start(name, pane, claude_args)
        accept_trust_dialog(pane, directory, blocked)
    except Exception:
        with suppress(subprocess.CalledProcessError, OSError):
            herdr("tab", "close", tab["tab"]["tab_id"])
        raise
    info = {"pane_id": pane, "tab_id": tab["tab"]["tab_id"], "dir": str(directory), "started": time.time()}
    write_atomic(reports / "manager.json", json.dumps(info))
    print(f"{name}: pane {pane}, reports {reports}")
    return 0


def newest_result(folder: Path) -> str:
    results = sorted(folder.glob("result-*.md"))
    return results[-1].name if results else "-"


def list_managers() -> int:
    space = space_dir()
    alive = live_panes()
    for folder in sorted(p for p in space.glob("*") if (p / "manager.json").exists()):
        pane = json.loads((folder / "manager.json").read_text())["pane_id"]
        state = "?" if alive is None else "live" if pane in alive else "gone"
        print(f"{folder.name}\t{state}\t{newest_result(folder)}")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="herdr-manager")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("register")
    sub.add_parser("list")
    starter = sub.add_parser("start")
    starter.add_argument("name")
    starter.add_argument("--resume")
    starter.add_argument("--dir", default=os.getcwd())
    args = parser.parse_args(argv)
    try:
        if args.command == "register":
            return register()
        if args.command == "start":
            return start(args.name, args.resume, args.dir)
        return list_managers()
    except ReportsError as err:
        print(f"herdr-manager: {err}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as err:
        print(f"herdr-manager: {' '.join(err.cmd[:3])} failed: {err.stderr.strip()}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
