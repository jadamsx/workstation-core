#!/usr/bin/env python3
"""Usage: herdr-manager register | setup [--no-work | --work] | start <name> [--resume <session-id>] [--dir <path>] | list | keep <name> [--off]

Three-tier work: the coordinator session registers its pane, each manager runs in its own tab of the same
herdr space, and herdr-report-watch carries the manager's result files to the coordinator.

register  run in the coordinator's pane and renames its tab `◆ lead`; re-run after a handoff and reports follow
          the new pane.
setup     run in the coordinator's pane: registers it, then opens a standing `▸ work` manager and a `? ask` tab
          (Haiku, read-only helper) unless they are already live. Re-run it to repair a missing tab.
          `--no-work` stores {"work": false} in the space's setup.json so setup never starts work (the space
          uses named managers or runs in place); `--work` stores true again. Plain setup keeps the stored choice.
start     opens a tab named `▸ <name>` running `claude --model sonnet` with the manager brief, and
          WORKSTATION_REPORTS pointing at the folder the manager writes result-<timestamp>.md into.
keep      sets `"keep": true` in the manager's manager.json (`--off` removes it): the watcher then never closes
          or clears that manager, and the human closes it.
list      the managers of this space, whether their pane is alive, and their newest result file.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from contextlib import suppress
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import (  # noqa: E402
    ASK_TAB, INPUT_BOX, LEAD_TAB, MANAGER_TAB, NAME, NO_STDIN_ENV, TRUST_DIALOG, ReportsError, herdr, live_panes, manager_folder, pane_text, read_manager, space_dir, wait_for_shell, work_enabled, write_atomic,
)

BRIEF = Path(__file__).resolve().parent.parent / "claude/templates/manager-brief.md"
ASK_BRIEF = BRIEF.with_name("ask-brief.md")
POLICY = BRIEF.parent.parent / "resource-policy.json"
MCP_SERVERS = BRIEF.parent.parent / "mcp.json"
SHELL_TIMEOUT = 20
STARTUP_TIMEOUT = 20
START_RETRIES = 3
IMPORTS_DIALOG = "Allow external CLAUDE.md file imports?"
STARTUP_DIALOGS = (TRUST_DIALOG, IMPORTS_DIALOG)
SESSION_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")


def mcp_args(role: str, folder: Path) -> list[str]:
    """Claude args that start only the MCP servers the resource policy (plus the mcp.json overlay) lists for the role."""
    try:
        catalog = json.loads(MCP_SERVERS.read_text())
        listed = json.loads(POLICY.read_text())["roles"]
        names = [*listed[role], *catalog.get("roles", {}).get(role, [])]
        servers = {n: catalog["mcpServers"][n] for n in names}
    except (OSError, ValueError, KeyError) as err:
        raise ReportsError(f"cannot start role {role!r} from {POLICY} and {MCP_SERVERS}: {type(err).__name__}: {err}") from err
    if role == "ask" and servers:
        raise ReportsError(f"the ask role must start no MCP servers, got {', '.join(servers)}")
    folder.mkdir(parents=True, exist_ok=True)
    config = folder / "mcp.json"
    write_atomic(config, json.dumps({"mcpServers": servers}))
    return ["--strict-mcp-config", "--mcp-config", str(config)]


def register() -> int:
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        raise ReportsError("not inside herdr: HERDR_PANE_ID is unset")
    path = space_dir() / "coordinator"
    write_atomic(path, pane + "\n")
    mine = next((p for p in herdr("pane", "list").get("panes", []) if p["pane_id"] == pane), None)
    if mine is None:
        raise ReportsError(f"pane {pane} is not in the herdr pane list")
    herdr("tab", "rename", mine["tab_id"], LEAD_TAB)
    print(f"coordinator {pane} -> {path}")
    return 0


def accept_trust_dialog(pane: str, directory: Path, blocked: bool = False) -> None:
    """Answer Claude Code's startup prompts, but only for folders under the coordinator's own directory."""
    if blocked:
        text = pane_text(pane)
        if not any(dialog in text for dialog in STARTUP_DIALOGS):
            tail = "\n".join(text.splitlines()[-5:])
            raise ReportsError(f"the agent in pane {pane} is blocked during startup and no startup dialog is visible:\n{tail}")
    cwd = Path.cwd().resolve()
    answered: set[str] = set()
    deadline = time.monotonic() + STARTUP_TIMEOUT
    while True:
        text = pane_text(pane)
        dialog = next((d for d in STARTUP_DIALOGS if d in text and d not in answered), None)
        if dialog is not None:
            if directory != cwd and cwd not in directory.parents:
                raise ReportsError(f"Claude Code does not trust {directory} and it is outside {cwd}; run claude there once to trust it")
            shown = text[text.index(dialog):]
            keys = ["Enter"] if re.search(r"❯\s*(1\.\s*)?Yes", shown) else ["Down", "Enter"]
            herdr("agent", "send-keys", pane, *keys)
            answered.add(dialog)
        elif INPUT_BOX.search(text):
            return
        elif time.monotonic() >= deadline:
            break
        time.sleep(0.2)
    if not answered:
        return
    raise ReportsError(f"the input box in pane {pane} never appeared after answering startup prompts for {directory}")


def agent_start(name: str, pane: str, claude_args: list[str]) -> bool:
    """`herdr agent start`, retried while herdr still reports the new pane busy; True if it started blocked on a prompt."""
    for attempt in range(START_RETRIES + 1):
        try:
            herdr("agent", "start", name, "--kind", "claude", "--pane", pane, "--", *claude_args)
            return False
        except subprocess.CalledProcessError as err:
            output = f"{err.stderr}{err.stdout}"
            if "agent_not_ready" in output:
                return True
            if "agent_pane_busy" not in output or attempt == START_RETRIES:
                raise
            time.sleep(float(os.environ.get("AGENT_START_RETRY_SECONDS", "2")))
    return False


def launch(name: str, label: str, env: list[str], directory: Path, claude_args: list[str]) -> tuple[str, str]:
    """Open a tab running claude and answer its startup prompts; the tab is closed again if that fails."""
    tab = herdr(
        "tab", "create", "--workspace", os.environ["HERDR_WORKSPACE_ID"], "--cwd", str(directory), "--label", label,
        *(arg for item in env for arg in ("--env", item)), "--env", "DISABLE_AUTO_UPDATE=true", "--env", "DISABLE_UPDATE_PROMPT=true",
        *(arg for item in NO_STDIN_ENV for arg in ("--env", item)), "--no-focus",
    )
    pane = tab["root_pane"]["pane_id"]
    try:
        if not wait_for_shell(pane, SHELL_TIMEOUT):
            raise ReportsError(f"the shell in pane {pane} never settled")
        blocked = agent_start(f"{name}-{space_dir().name}", pane, claude_args)
        accept_trust_dialog(pane, directory, blocked)
    except Exception:
        with suppress(subprocess.CalledProcessError, OSError):
            herdr("tab", "close", tab["tab"]["tab_id"])
        raise
    return pane, tab["tab"]["tab_id"]


def start(name: str, resume: str | None, directory: str, standing: bool = False) -> int:
    if not NAME.fullmatch(name):
        raise ReportsError(f"name must match {NAME.pattern}: {name!r}")
    if resume and not SESSION_ID.fullmatch(resume):
        raise ReportsError(f"--resume needs a session id, got {resume!r}")
    reports = space_dir() / name
    previous: dict = {}
    if (reports / "manager.json").exists():
        previous = read_manager(reports)
        if not previous.get("closed") and previous.get("pane_id") in (live_panes() or set()):
            raise ReportsError(f"manager {name!r} is already running in pane {previous['pane_id']}")
    reports.mkdir(parents=True, exist_ok=True)
    directory = Path(directory).resolve()
    role = name if name == "work" else "manager"
    claude_args = ["--model", "sonnet", *(["--resume", resume] if resume else []), *mcp_args(role, reports), "--append-system-prompt-file", str(BRIEF)]
    pane, tab_id = launch(name, MANAGER_TAB + name, [f"WORKSTATION_REPORTS={reports}"], directory, claude_args)
    carried = {k: True for k in ("standing", "keep") if previous.get(k)}
    info = {"pane_id": pane, "tab_id": tab_id, "dir": str(directory), "started": time.time(), **carried, **({"standing": True} if standing else {})}
    write_atomic(reports / "manager.json", json.dumps(info))
    print(f"{name}: pane {pane}, reports {reports}")
    return 0


def setup(work: bool | None) -> int:
    """Register this pane as the lead, then open the standing work (unless the space opted out) and ask tabs that are not already there."""
    register()
    directory = Path.cwd()
    space = space_dir()
    if work is not None:
        write_atomic(space / "setup.json", json.dumps({"work": work}))
    manifest = space / "work" / "manager.json"
    info = json.loads(manifest.read_text()) if manifest.exists() else {}
    if work_enabled(space) and (info.get("closed") or info.get("pane_id") not in (live_panes() or set())):
        start("work", None, str(directory), standing=True)
    tabs = herdr("tab", "list", "--workspace", os.environ["HERDR_WORKSPACE_ID"]).get("tabs", [])
    if not any(tab.get("label") == ASK_TAB for tab in tabs):
        pane, _ = launch("ask", ASK_TAB, ["WORKSTATION_ROLE=ask"], directory,
                      ["--model", "haiku", *mcp_args("ask", space / "ask"), "--append-system-prompt-file", str(ASK_BRIEF)])
        print(f"ask: pane {pane}")
    return 0


def newest_result(folder: Path) -> str:
    results = sorted(folder.glob("result-*.md"))
    return results[-1].name if results else "-"


def list_managers() -> int:
    space = space_dir()
    alive = live_panes()
    for folder in sorted(p for p in space.glob("*") if (p / "manager.json").exists()):
        pane = json.loads((folder / "manager.json").read_text())["pane_id"]
        state = "?" if alive is None else "live" if pane in alive else "gone"
        print(f"{folder.name}\t{state}\t{newest_result(folder)}")
    return 0


def keep(name: str, off: bool) -> int:
    folder = manager_folder(name)
    info = read_manager(folder)
    if off:
        info.pop("keep", None)
    else:
        info["keep"] = True
    write_atomic(folder / "manager.json", json.dumps(info))
    print(f"{name}: {'no longer kept' if off else 'kept'}")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="herdr-manager")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("register")
    setup_parser = sub.add_parser("setup")
    choice = setup_parser.add_mutually_exclusive_group()
    choice.add_argument("--no-work", dest="work", action="store_false", default=None)
    choice.add_argument("--work", dest="work", action="store_true")
    sub.add_parser("list")
    starter = sub.add_parser("start")
    starter.add_argument("name")
    starter.add_argument("--resume")
    starter.add_argument("--dir", default=os.getcwd())
    keeper = sub.add_parser("keep")
    keeper.add_argument("name")
    keeper.add_argument("--off", action="store_true")
    args = parser.parse_args(argv)
    try:
        if args.command == "register":
            return register()
        if args.command == "setup":
            return setup(args.work)
        if args.command == "start":
            return start(args.name, args.resume, args.dir)
        if args.command == "keep":
            return keep(args.name, args.off)
        return list_managers()
    except ReportsError as err:
        print(f"herdr-manager: {err}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as err:
        print(f"herdr-manager: {' '.join(err.cmd[:3])} failed: {err.stderr.strip()}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
