#!/usr/bin/env python3
"""Open a visible browser once so you can log in, then save the session for headless use by shot."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from browser_common import DEFAULT_VIEWPORT, launch, parse_viewport, state_path  # noqa: E402
from playwright.sync_api import sync_playwright  # noqa: E402


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="browser-login", description=__doc__)
    parser.add_argument("env", help="name for the saved state, e.g. dev or staging")
    parser.add_argument("url")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    path = state_path(args.env)
    path.parent.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        browser = launch(playwright, headed=True)
        context = browser.new_context(viewport=parse_viewport(DEFAULT_VIEWPORT))
        context.new_page().goto(args.url)
        input("Log in in the browser window, then press Enter here to save the session. ")
        context.storage_state(path=str(path))
        path.chmod(0o600)
        browser.close()
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
