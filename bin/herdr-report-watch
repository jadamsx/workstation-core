#!/usr/bin/env python3
"""Usage: herdr-report-watch [--once] [--interval <seconds>]

Carries manager reports to the coordinator without spending tokens: every pass, each new
`*.md` file in a manager folder is sent once as `[worker-report] <path>` with `herdr agent prompt`
to the pane saved by `herdr-manager register`. A send that fails, including while the coordinator sits
at a permission prompt (agent_blocked), is retried every 15 seconds. A manager whose pane is gone and
that has nothing unsent produces `[worker-report] <name> exited without a report`, once per pane. A report whose first
line is `Status: done` also closes that manager's tab (as `manager-close` does) and silences the exited line; a
`Status: decision` report leaves the tab open. A kept manager (`"keep": true`, set with `herdr-manager keep`) gets its
reports delivered but is never closed or cleared, and is idle-checked like a standing one. A standing manager (`"standing": true` in manager.json, the `work`
tab) is never closed: once a `Status: done` report is delivered and its pane is idle, the watcher sends it `/clear`
with `herdr agent prompt`, once per report. A standing manager is idle-checked only after its pane was seen working
since its newest report or the last `/clear`. A manager idle for 15 minutes without writing a report, whose last
message does not start with `WAITING:`, produces `[worker-report] <name> idle, no report` plus the last lines of its
pane, once per idle spell.

Jobs `manager-send` parked at the usage limit sit as files in `<root>/.parked/`. Once `usage-gate` is open (under
the limit, past the reset, overridden or failing open) the watcher sends them in order through `manager-send`'s send
path, drops a job whose manager is gone, and each coordinator gets one
`[worker-report] resumed parked jobs: <names>` line.

A shell started by a Bash tool call (its command names `shell-snapshots`) under a `claude` process is reaped when
it and its child processes together have used no CPU for 10 minutes and it is older than 10 minutes: SIGTERM, then
SIGKILL 5 seconds later if it is still there. Output cannot be watched cheaply, so CPU is the only signal. Jobs
whose command line contains a `reaper_keep` substring from `claude/resource-policy.json` are left alone. A shell under
a manager's claude also gets a `Status: decision` report, `reaped-<pid>.md`, in that manager's folder.

Sent files are recorded in `<root>/.watch-state.json`. Every send and retry is logged to stdout, which
the launchd agent writes to ~/Library/Logs/herdr-report-watch.log.
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time
from typing import Callable, NamedTuple
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import IDLE_STATES, ReportsError, close_manager, is_done, pane_states, pane_text, read_manager, reports_root, write_atomic  # noqa: E402

usage_gate = SourceFileLoader("usage_gate", str(Path(__file__).resolve().parent / "usage-gate")).load_module()
manager_send = SourceFileLoader("manager_send", str(Path(__file__).resolve().parent / "manager-send")).load_module()

RETRY_SECONDS = 15
IDLE_SECONDS = 900
TAIL_LINES = 15
WAITING = "WAITING:"
REAP_IDLE_SECONDS = 600
KILL_GRACE_SECONDS = 5
SHELLS = {"bash", "zsh", "sh"}
BASH_TOOL_MARK = "shell-snapshots"
POLICY = Path(__file__).resolve().parent.parent / "claude/resource-policy.json"


class Proc(NamedTuple):
    pid: int
    ppid: int
    age: float
    cpu: float
    command: str


def clock_seconds(text: str) -> float:
    """Seconds in a ps `[[dd-]hh:]mm:ss[.ff]` field."""
    days, _, clock = text.rpartition("-")
    total = 0.0
    for part in clock.split(":"):
        total = total * 60 + float(part)
    return total + (int(days) * 86400 if days else 0)


def read_procs() -> list[Proc]:
    out = subprocess.run(["ps", "-axo", "pid,ppid,etime,time,command"], check=True, capture_output=True, text=True).stdout
    rows = (line.split(None, 4) for line in out.splitlines()[1:])
    return [Proc(int(r[0]), int(r[1]), clock_seconds(r[2]), clock_seconds(r[3]), r[4]) for r in rows if len(r) == 5]


def argv0(proc: Proc) -> str:
    return Path(proc.command.split(None, 1)[0]).name.lstrip("-")


def last_message(text: str) -> str:
    """The text of the newest assistant message in a pane read, whose lines start with `●`."""
    marked = [line.strip() for line in text.splitlines() if line.strip().startswith("●")]
    return marked[-1].lstrip("● ").strip() if marked else ""


class Watcher:
    def __init__(self, root: Path, procs: Callable[[], list[Proc]] = read_procs, kill: Callable[[int, int], None] = os.kill) -> None:
        self.root = root
        self.procs = procs
        self.kill = kill
        self.cpu_seen: dict[int, tuple[float, float]] = {}
        self.terminated: dict[int, float] = {}
        self.state_file = root / ".watch-state.json"
        self.state = {"sent": [], "exited": [], "idle": [], "cleared": []}
        if self.state_file.exists():
            self.state.update(json.loads(self.state_file.read_text()))
        self.retry_at: dict[str, float] = {}
        self.spells: dict[str, dict] = {}
        self.worked: dict[str, int] = {}
        self.clearing: set[str] = set()

    def log(self, message: str) -> None:
        print(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {message}", flush=True)

    def deliver(self, key: str, coordinator: str | None, text: str, record: str | None, now: float) -> bool:
        if now < self.retry_at.get(key, 0):
            return False
        if coordinator is None:
            error = "no coordinator registered"
        else:
            done = subprocess.run(["herdr", "agent", "prompt", coordinator, text], capture_output=True, text=True)
            if done.returncode == 0:
                if record:
                    self.state[record].append(key)
                    write_atomic(self.state_file, json.dumps(self.state))
                self.retry_at.pop(key, None)
                self.log(f"sent {text}")
                return True
            error = (done.stderr.strip() or done.stdout.strip() or f"exit {done.returncode}").splitlines()[0]
        self.retry_at[key] = now + RETRY_SECONDS
        self.log(f"retry in {RETRY_SECONDS}s {text}: {error}")
        return False

    def close(self, manager: Path) -> None:
        try:
            close_manager(manager)
            self.log(f"closed {manager.name}")
        except (ReportsError, subprocess.CalledProcessError) as err:
            self.log(f"could not close {manager.name}: {err}")

    def note_work(self, pane: str, status: str, results: int) -> None:
        """Remember that a standing pane worked after its newest report, ignoring the work of a /clear we sent."""
        if pane in self.clearing:
            if status in IDLE_STATES:
                self.clearing.discard(pane)
        elif status not in IDLE_STATES:
            self.worked[pane] = results

    def track_idle(self, pane: str, status: str, results: int, now: float) -> dict:
        """Per-pane idle bookkeeping: when the current idle spell began and whether a report came with it."""
        spell = self.spells.get(pane)
        if status not in IDLE_STATES:
            self.spells[pane] = {"active_results": results, "since": None, "reported": True, "checked": False}
            if pane in self.state["idle"]:
                self.state["idle"].remove(pane)
                write_atomic(self.state_file, json.dumps(self.state))
        elif spell is None:
            self.spells[pane] = {"active_results": results, "since": now, "reported": bool(results), "checked": False}
        elif spell["since"] is None:
            spell.update(since=now, reported=results > spell["active_results"])
        return self.spells[pane]

    def report_idle(self, manager: Path, pane: str, spell: dict, coordinator: str | None, now: float) -> None:
        if spell["reported"] or spell["checked"] or pane in self.state["idle"] or now - spell["since"] < IDLE_SECONDS:
            return
        try:
            text = pane_text(pane)
        except (subprocess.CalledProcessError, OSError):
            return
        if last_message(text).startswith(WAITING):
            spell["checked"] = True
            return
        tail = "\n".join([line for line in text.splitlines() if line.strip()][-TAIL_LINES:])
        self.deliver(pane, coordinator, f"[worker-report] {manager.name} idle, no report\n{tail}", "idle", now)

    def resume_parked(self) -> None:
        if usage_gate.parked_until() is not None:
            return
        resumed: dict[str, list[str]] = {}
        for path in sorted((self.root / ".parked").glob("*.json")):
            try:
                job = json.loads(path.read_text())
                folder = Path(job["folder"])
                info = read_manager(folder)
                if info.get("closed"):
                    raise ReportsError("manager is closed")
            except (OSError, ValueError, KeyError, TypeError, ReportsError) as err:
                self.log(f"dropped parked job {path.name}: {err}")
                path.unlink(missing_ok=True)
                continue
            try:
                manager_send.send(folder, info, job["text"], time.monotonic(), 0)
            except ReportsError as err:
                self.log(f"could not resume {folder.name}: {err}")
                continue
            path.unlink(missing_ok=True)
            resumed.setdefault(str(folder.parent / "coordinator"), []).append(folder.name)
            self.log(f"resumed {folder.name}")
        wall = time.time()
        for coordinator_file, names in resumed.items():
            path = Path(coordinator_file)
            coordinator = path.read_text().strip() if path.exists() else None
            self.deliver(f"resumed:{wall}:{coordinator_file}", coordinator, f"[worker-report] resumed parked jobs: {', '.join(names)}", None, wall)

    def reap(self, now: float) -> None:
        """Stop Bash-tool shells under a claude process that have burnt no CPU for REAP_IDLE_SECONDS, unless a keep-listed job runs in them."""
        try:
            keep = json.loads(POLICY.read_text())["reaper_keep"]
            procs = self.procs()
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as err:
            self.log(f"reaper skipped: {err}")
            return
        by_pid = {p.pid: p for p in procs}
        children: dict[int, list[Proc]] = {}
        for p in procs:
            children.setdefault(p.ppid, []).append(p)

        def claude_above(proc: Proc) -> Proc | None:
            seen = set()
            while proc.ppid in by_pid and proc.ppid not in seen:
                seen.add(proc.ppid)
                proc = by_pid[proc.ppid]
                if argv0(proc) == "claude":
                    return proc
            return None

        owners = {p.pid: c for p in procs if argv0(p) in SHELLS and BASH_TOOL_MARK in p.command and (c := claude_above(p))}
        seen_cpu: dict[int, tuple[float, float]] = {}
        for pid, claude in owners.items():
            tree, queue = [], [by_pid[pid]]
            while queue:
                tree.append(queue.pop())
                queue += children.get(tree[-1].pid, [])
            cpu = sum(p.cpu for p in tree)
            before = self.cpu_seen.get(pid)
            since = before[1] if before and before[0] == cpu else now
            seen_cpu[pid] = (cpu, since)
            shell = by_pid[pid]
            if shell.ppid in owners or pid in self.terminated or now - since <= REAP_IDLE_SECONDS or shell.age <= REAP_IDLE_SECONDS:
                continue
            if any(k in p.command for p in tree for k in keep):
                continue
            self.stop(shell, claude)
            self.terminated[pid] = now
        self.cpu_seen = seen_cpu
        for pid, since in list(self.terminated.items()):
            if pid not in by_pid:
                del self.terminated[pid]
            elif now - since >= KILL_GRACE_SECONDS:
                self.kill(pid, signal.SIGKILL)
                del self.terminated[pid]

    def stop(self, shell: Proc, claude: Proc) -> None:
        command = shell.command.split("eval ", 1)[-1][:200]
        self.kill(shell.pid, signal.SIGTERM)
        self.log(f"reaped shell {shell.pid}: {command}")
        for info in self.root.glob("*/*/manager.json"):
            if f"{info.parent}/mcp.json" in claude.command:
                body = (
                    "Status: decision\n"
                    f"Stopped shell pid {shell.pid}: no CPU use for over {REAP_IDLE_SECONDS // 60} minutes.\n"
                    f"Command: {command}\n"
                    "Rerun it with run_in_background if it should run that long, or add it to reaper_keep in resource-policy.json.\n"
                )
                write_atomic(info.parent / f"reaped-{shell.pid}.md", body)

    def scan(self, now: float) -> None:
        if self.state_file.exists():
            on_disk = json.loads(self.state_file.read_text()).get("cleared", [])
            self.state["cleared"] = [*self.state["cleared"], *(k for k in on_disk if k not in self.state["cleared"])]
        self.resume_parked()
        self.reap(now)
        panes: dict[str, str] | None = None
        for space in sorted(p for p in self.root.glob("*") if p.is_dir()):
            coordinator_file = space / "coordinator"
            coordinator = coordinator_file.read_text().strip() if coordinator_file.exists() else None
            for manager in sorted(p for p in space.glob("*") if (p / "manager.json").exists()):
                allresults = sorted(manager.glob("*.md"))
                pending = [r for r in allresults if str(r) not in self.state["sent"]]
                for result in pending:
                    if not self.deliver(str(result), coordinator, f"[worker-report] {result}", "sent", now):
                        break
                else:
                    info = read_manager(manager)
                    results = [r for r in allresults if r.stat().st_mtime > info.get("started", 0)]
                    if results and is_done(results[-1]) and not (info.get("standing") or info.get("keep") or info.get("closed")):
                        self.close(manager)
                        continue
                    pane = info["pane_id"]
                    if pane in self.state["exited"] or info.get("closed"):
                        continue
                    panes = pane_states() if panes is None else panes
                    if panes is None:
                        continue
                    done = bool(results) and is_done(results[-1])
                    standing = bool(info.get("standing"))
                    kept = bool(info.get("keep"))
                    longlived = standing or kept
                    if longlived and pane in panes:
                        self.note_work(pane, panes[pane], len(results))
                    if standing and not kept and done and str(results[-1]) not in self.state["cleared"] and panes.get(pane) in IDLE_STATES:
                        if self.deliver(str(results[-1]), pane, "/clear", "cleared", now):
                            self.worked.pop(pane, None)
                            self.clearing.add(pane)
                    resumed = longlived and self.worked.get(pane) == len(results)
                    if (done or (longlived and not results)) and not resumed:
                        continue
                    if pane not in panes:
                        self.deliver(pane, coordinator, f"[worker-report] {manager.name} exited without a report", "exited", now)
                    else:
                        spell = self.track_idle(pane, panes[pane], len(results), now)
                        self.report_idle(manager, pane, spell, coordinator, now)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="herdr-report-watch")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=float, default=3.0)
    args = parser.parse_args(argv)
    watcher = Watcher(reports_root())
    while True:
        watcher.scan(time.monotonic())
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
