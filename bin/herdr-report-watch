#!/usr/bin/env python3
"""Usage: herdr-report-watch [--once] [--interval <seconds>]

Carries manager reports to the coordinator without spending tokens: each new `*.md` file in a manager folder is sent once
as `[worker-report] <path>` with `herdr agent prompt` to the pane saved by `herdr-manager register`. A failed send is
retried every 15 seconds. A `Status: done` report also closes the manager's tab (a standing manager is `/clear`ed, a kept one
left open); a manager whose pane is gone is reported once. Every 30 seconds each manager tab is checked: one
`[watcher] <tab> looks stuck: <reason>` line goes to the lead when it shows no activity (reports, transcripts, CPU-using
shells) for STALL_SECONDS, a permission prompt has stood for 60 seconds, or one guard refused it 3 times in STALL_SECONDS;
it re-arms on new activity. Parked `manager-send` jobs resume when `usage-gate` opens. Bash-tool shells under a claude in a lead, work or manager pane that burn no CPU for
10 minutes are reaped (never any other pane). A manager.json with `plan` and `dir` lets it prompt the lead about unstarted
ready nodes and long shell waits. State is in `<root>/.watch-state.json`; stdout goes to ~/Library/Logs/herdr-report-watch.log.
"""
import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime
from typing import Callable
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import IDLE_STATES, BASH_TOOL_SHELL, KILL_GRACE_SECONDS, SHELLS, Proc, ReportsError, argv0, clock_seconds, close_manager, is_done, managed_shell_pids, pane_states, pane_text, read_manager, read_procs, reports_root, same_process, stop_shell, write_atomic  # noqa: E402

usage_gate = SourceFileLoader("usage_gate", str(Path(__file__).resolve().parent / "usage-gate")).load_module()
manager_send = SourceFileLoader("manager_send", str(Path(__file__).resolve().parent / "manager-send")).load_module()

RETRY_SECONDS = 15
STALL_SECONDS = int(os.environ.get("STALL_SECONDS", "600"))
STUCK_CHECK_SECONDS = 30
PROMPT_SECONDS = 60
GUARD_REFUSALS = 3
TRANSCRIPT_TAIL_BYTES = 1 << 20
PROJECTS = Path.home() / ".claude/projects"
PERMISSION_PROMPT = re.compile(r"Do you want to [^\n]*\n[│\s]*❯ 1\. Yes")
GUARD_REFUSAL = re.compile(r'"content":"[\w:.-]+ hook error: \[(?:[^\]]*/)?([\w.-]+)[^\]]*\]')
TIMESTAMP = re.compile(r'"timestamp":"([^"]+)"')
REAP_IDLE_SECONDS = int(os.environ.get("REAP_IDLE_SECONDS", "600"))
READY_ALERT_SECONDS = 120
POLICY = Path(__file__).resolve().parent.parent / "claude/resource-policy.json"


def plan_needs(text: str) -> dict[str, tuple[str, ...]]:
    """Node id to the ids its Wave cell `N (needs X, Y)` names, from the note's `## Node table`."""
    rows, inside = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            inside = line[3:].strip() == "Node table"
        elif inside and line.startswith("|"):
            rows.append([c.strip() for c in line.strip().strip("|").split("|")])
    if len(rows) < 3 or "wave" not in (header := [c.lower() for c in rows[0]]):
        return {}
    nodes = {}
    for row in rows[2:]:
        ident, needs = re.match(r"[`*]*([\w-]+)", row[0]), re.search(r"needs\s+([^)]*)", row[header.index("wave")])
        if ident:
            nodes[ident[1]] = tuple(re.findall(r"\bN\d+\b", needs[1])) if needs else ()
    return nodes


def plan_marks(text: str) -> dict[str, str]:
    """Node id to the mark of its `- [ ] Nn title` line under `## Progress`."""
    marks, inside = {}, False
    for line in text.splitlines():
        if line.startswith("## "):
            inside = line[3:].strip() == "Progress"
        elif inside and (m := re.match(r"- \[([ ~xX])\] (\S+)", line)):
            marks[m[2]] = m[1].lower()
    return marks


def owned_nodes(trees: list[Path]) -> set[str]:
    """Ids named by `.owns` files (`node: Nn` or manager-send's `. Nn`) in the trees and their worktrees."""
    owns = [o for t in trees for o in [t / ".owns", *t.glob(".claude/worktrees/*/.owns")] if o.is_file()]
    return {m[1] for o in owns if (m := re.match(r"(?:node:|\.)\s*(\S+)", o.read_text().split("\n")[0]))}


def commit_time(trees: list[Path], node: str) -> float | None:
    """Commit time of the newest commit with trailer `Node: <node>` in any of the trees' repos."""
    times = []
    for tree in trees:
        out = subprocess.run(["git", "-C", str(tree), "log", "--all", "-1", "--format=%ct", "-E", f"--grep=^Node: {node}$"], capture_output=True, text=True)
        times += [float(t) for t in out.stdout.split()]
    return max(times, default=None)


def transcripts(session: str | None) -> list[Path]:
    """The session transcript and its subagent transcripts."""
    return [*PROJECTS.glob(f"*/{session}.jsonl"), *PROJECTS.glob(f"*/{session}/subagents/*.jsonl")] if session else []


class Watcher:
    def __init__(self, root: Path, procs: Callable[[], list[Proc]] = read_procs, kill: Callable[[int, int], None] = os.kill, wall: Callable[[], float] = time.time) -> None:
        self.root = root
        self.wall = wall
        self.shell_wait: dict[Path, float] = {}
        self.shell_busy: dict[Path, float] = {}
        self.procs = procs
        self.kill = kill
        self.cpu_seen: dict[int, tuple[float, float, bool]] = {}
        self.terminated: dict[int, tuple[float, Proc]] = {}
        self.state_file = root / ".watch-state.json"
        self.state = {"sent": [], "exited": [], "stuck": {}, "cleared": []}
        if self.state_file.exists():
            self.state.update(json.loads(self.state_file.read_text()))
        self.retry_at: dict[str, float] = {}
        self.prompt_since: dict[str, float] = {}
        self.stuck_at = 0.0
        self.worked: dict[str, int] = {}
        self.clearing: set[str] = set()

    def log(self, message: str) -> None:
        print(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {message}", flush=True)

    def deliver(self, key: str, coordinator: str | None, text: str, record: str | None, now: float) -> bool:
        if now < self.retry_at.get(key, 0):
            return False
        if coordinator is None:
            error = "no coordinator registered"
        else:
            done = subprocess.run(["herdr", "agent", "prompt", coordinator, text], capture_output=True, text=True)
            if done.returncode == 0:
                if record:
                    self.state[record].append(key)
                    write_atomic(self.state_file, json.dumps(self.state))
                self.retry_at.pop(key, None)
                self.log(f"sent {text}")
                return True
            error = (done.stderr.strip() or done.stdout.strip() or f"exit {done.returncode}").splitlines()[0]
        self.retry_at[key] = now + RETRY_SECONDS
        self.log(f"retry in {RETRY_SECONDS}s {text}: {error}")
        return False

    def close(self, manager: Path) -> None:
        try:
            close_manager(manager)
            self.log(f"closed {manager.name}")
        except (ReportsError, subprocess.CalledProcessError) as err:
            self.log(f"could not close {manager.name}: {err}")

    def note_work(self, pane: str, status: str, results: int) -> None:
        """Remember that a standing pane worked after its newest report, ignoring the work of a /clear we sent."""
        if pane in self.clearing:
            if status in IDLE_STATES:
                self.clearing.discard(pane)
        elif status not in IDLE_STATES:
            self.worked[pane] = results

    def last_activity(self, manager: Path, info: dict, now: float) -> float:
        """Newest of the tab's start, its reports, its transcripts, and its last CPU-using shell, as wall time."""
        busy = self.shell_busy.get(manager)
        files = [*manager.glob("*.md"), *transcripts(info.get("session_id"))]
        return max(info.get("started", 0), self.wall() - (now - busy) if busy else 0, *(f.stat().st_mtime for f in files))

    def refused_by(self, session: str | None, wall: float, after: float) -> tuple[str, int] | None:
        """The guard that refused the session most often within STALL_SECONDS and after `after`, with the count."""
        counts: Counter[str] = Counter()
        for path in transcripts(session):
            with path.open("rb") as handle:
                skipped = max(0, path.stat().st_size - TRANSCRIPT_TAIL_BYTES)
                handle.seek(skipped)
                lines = handle.read().decode(errors="replace").splitlines()
            for line in lines[1:] if skipped else lines:
                refusal, stamp = GUARD_REFUSAL.search(line), TIMESTAMP.search(line)
                if refusal and stamp and datetime.fromisoformat(stamp[1].replace("Z", "+00:00")).timestamp() > max(after, wall - STALL_SECONDS):
                    counts[refusal[1]] += 1
        return counts.most_common(1)[0] if counts else None

    def stuck_reason(self, active: float, since: float | None, refused: tuple[str, int] | None, wall: float) -> str | None:
        if wall - active >= STALL_SECONDS:
            return f"no activity for {int((wall - active) // 60)} min"
        if since is not None and wall - since >= PROMPT_SECONDS:
            return f"permission prompt open for {int(wall - since)} s"
        if refused and refused[1] >= GUARD_REFUSALS:
            return f"{refused[0]} refused it {refused[1]} times"
        return None

    def check_stuck(self, manager: Path, info: dict, pane: str, status: str, coordinator: str | None, now: float) -> None:
        wall = self.wall()
        try:
            shown = status == "blocked" or bool(PERMISSION_PROMPT.search(pane_text(pane)))
        except (subprocess.CalledProcessError, OSError):
            shown = False
        since = self.prompt_since.setdefault(pane, wall) if shown else self.prompt_since.pop(pane, None)
        reported = self.state["stuck"].get(pane)
        try:
            active = self.last_activity(manager, info, now)
            rearmed = reported is None or active > reported["active"]
            refused = self.refused_by(info.get("session_id"), wall, reported["at"] if reported else 0) if rearmed else None
        except (OSError, ValueError):
            return
        reason = self.stuck_reason(active, since, refused, wall) if active and rearmed else None
        if reason and self.deliver(f"stuck:{pane}", coordinator, f"[watcher] {manager.name} looks stuck: {reason}. Assume the worst and kick it.", None, now):
            self.state["stuck"][pane] = {"active": active, "at": wall}
            write_atomic(self.state_file, json.dumps(self.state))

    def resume_parked(self) -> None:
        if usage_gate.parked_until() is not None:
            return
        resumed: dict[str, list[str]] = {}
        for path in sorted((self.root / ".parked").glob("*.json")):
            try:
                job = json.loads(path.read_text())
                folder = Path(job["folder"])
                info = read_manager(folder)
                if info.get("closed"):
                    raise ReportsError("manager is closed")
            except (OSError, ValueError, KeyError, TypeError, ReportsError) as err:
                self.log(f"dropped parked job {path.name}: {err}")
                path.unlink(missing_ok=True)
                continue
            try:
                manager_send.send(folder, info, job["text"], time.monotonic(), 0)
            except ReportsError as err:
                self.log(f"could not resume {folder.name}: {err}")
                continue
            path.unlink(missing_ok=True)
            resumed.setdefault(str(folder.parent / "coordinator"), []).append(folder.name)
            self.log(f"resumed {folder.name}")
        wall = time.time()
        for coordinator_file, names in resumed.items():
            path = Path(coordinator_file)
            coordinator = path.read_text().strip() if path.exists() else None
            self.deliver(f"resumed:{wall}:{coordinator_file}", coordinator, f"[worker-report] resumed parked jobs: {', '.join(names)}", None, wall)

    def reap(self, now: float) -> None:
        """Stop Bash-tool shells under a claude process that have burnt no CPU for REAP_IDLE_SECONDS, unless a keep-listed job runs in them."""
        try:
            keep = json.loads(POLICY.read_text())["reaper_keep"]
            procs = self.procs()
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as err:
            self.log(f"reaper skipped: {err}")
            return
        self.shell_wait = {}
        self.shell_busy = {f: t for f, t in self.shell_busy.items() if (f / "manager.json").exists()}
        by_pid = {p.pid: p for p in procs}
        children: dict[int, list[Proc]] = {}
        for p in procs:
            children.setdefault(p.ppid, []).append(p)

        def claude_above(proc: Proc) -> Proc | None:
            seen = set()
            while proc.ppid in by_pid and proc.ppid not in seen:
                seen.add(proc.ppid)
                proc = by_pid[proc.ppid]
                if argv0(proc) == "claude":
                    return proc
            return None

        owners = {p.pid: c for p in procs if argv0(p) in SHELLS and BASH_TOOL_SHELL.match(p.command) and (c := claude_above(p))}
        if owners:
            try:
                managed = managed_shell_pids()
            except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as err:
                self.log(f"reaper skipped: {err}")
                return

            def in_managed_pane(proc: Proc) -> bool:
                seen = {proc.pid}
                while proc.ppid not in managed and proc.ppid in by_pid and proc.ppid not in seen:
                    proc = by_pid[proc.ppid]
                    seen.add(proc.pid)
                return proc.ppid in managed

            owners = {pid: c for pid, c in owners.items() if in_managed_pane(c)}
        seen_cpu: dict[int, tuple[float, float, bool]] = {}
        for pid, claude in owners.items():
            tree, queue = [], [by_pid[pid]]
            while queue:
                tree.append(queue.pop())
                queue += children.get(tree[-1].pid, [])
            cpu = sum(p.cpu for p in tree)
            before = self.cpu_seen.get(pid)
            changed = before is not None and before[0] != cpu
            since = before[1] if before and not changed else now
            moved = changed or bool(before and before[2])
            seen_cpu[pid] = (cpu, since, moved)
            shell = by_pid[pid]
            for folder in self.managers_of(claude):
                if moved:
                    self.shell_busy[folder] = max(self.shell_busy.get(folder, 0), since)
                if shell.ppid not in owners:
                    self.shell_wait[folder] = max(self.shell_wait.get(folder, 0), shell.age)
            if shell.ppid in owners or pid in self.terminated or now - since <= REAP_IDLE_SECONDS or shell.age <= REAP_IDLE_SECONDS:
                continue
            if any(k in p.command for p in tree for k in keep):
                continue
            self.stop(shell, claude, procs)
            self.terminated[pid] = (now, shell)
        self.cpu_seen = seen_cpu
        for pid, (since, was) in list(self.terminated.items()):
            if pid not in by_pid:
                del self.terminated[pid]
            elif now - since >= KILL_GRACE_SECONDS:
                if same_process(was, lambda: procs):
                    self.kill(pid, signal.SIGKILL)
                del self.terminated[pid]

    def stop(self, shell: Proc, claude: Proc, procs: list[Proc]) -> None:
        command = shell.command.split("eval ", 1)[-1][:200]
        stop_shell(shell.pid, lambda: procs, self.kill)
        self.log(f"reaped shell {shell.pid}: {command}")
        for folder in self.managers_of(claude):
            body = (
                "Status: decision\n"
                f"Stopped shell pid {shell.pid}: no CPU use for over {REAP_IDLE_SECONDS // 60} minutes.\n"
                f"Command: {command}\n"
                "Rerun it in the foreground with a timeout, or add the command to reaper_keep in claude/resource-policy.json.\n"
            )
            write_atomic(folder / f"reaped-{shell.pid}.md", body)

    def managers_of(self, claude: Proc) -> list[Path]:
        return [info.parent for info in self.root.glob("*/*/manager.json") if f"{info.parent}/mcp.json" in claude.command]

    def alert(self, key: str, coordinator: str | None, text: str, now: float) -> None:
        if key not in self.state["sent"]:
            self.deliver(key, coordinator, text, "sent", now)

    def alert_lead(self, space: Path, coordinator: str | None, now: float) -> None:
        """Prompt the lead once per node and condition: ready and unstarted for READY_ALERT_SECONDS, or its manager's shell older than REAP_IDLE_SECONDS.
        The plan is the `plan` field of a manager.json in the space."""
        managers = {m: read_manager(m) for m in space.glob("*") if (m / "manager.json").exists()}
        trees = [Path(i["dir"]) for i in managers.values() if i.get("dir")]
        wall = self.wall()
        for folder, info in managers.items():
            wait = self.shell_wait.get(folder, 0)
            running = owned_nodes([Path(info["dir"])]) if info.get("dir") else set()
            for node in running if wait > REAP_IDLE_SECONDS else ():
                self.alert(f"alert:{folder}:{node}:shell", coordinator, f"[watcher] {node} waiting on a shell for {int(wait // 60)} min", now)
        for plan in {Path(i["plan"]).expanduser() for i in managers.values() if i.get("plan")}:
            try:
                text, edited = plan.read_text(), plan.stat().st_mtime
            except OSError:
                continue
            needs, marks, running = plan_needs(text), plan_marks(text), owned_nodes(trees)
            committed = {n: commit_time(trees, n) for n in needs}
            finished = lambda n: marks.get(n) == "x" or committed[n] is not None
            for node, deps in needs.items():
                if finished(node) or marks.get(node) == "~" or node in running or not all(d in needs and finished(d) for d in deps):
                    continue
                since = max((committed[d] or edited for d in deps), default=edited)
                if wall - since > READY_ALERT_SECONDS:
                    self.alert(f"alert:{plan}:{node}:ready", coordinator, f"[watcher] {node} ready for {int((wall - since) // 60)} min and not started", now)

    def scan(self, now: float) -> None:
        if self.state_file.exists():
            on_disk = json.loads(self.state_file.read_text()).get("cleared", [])
            self.state["cleared"] = [*self.state["cleared"], *(k for k in on_disk if k not in self.state["cleared"])]
        self.resume_parked()
        self.reap(now)
        stuck_due = now >= self.stuck_at
        if stuck_due:
            self.stuck_at = now + STUCK_CHECK_SECONDS
        panes: dict[str, str] | None = None
        for space in sorted(p for p in self.root.glob("*") if p.is_dir()):
            coordinator_file = space / "coordinator"
            coordinator = coordinator_file.read_text().strip() if coordinator_file.exists() else None
            self.alert_lead(space, coordinator, now)
            for manager in sorted(p for p in space.glob("*") if (p / "manager.json").exists()):
                allresults = sorted(manager.glob("*.md"))
                pending = [r for r in allresults if str(r) not in self.state["sent"]]
                for result in pending:
                    if not self.deliver(str(result), coordinator, f"[worker-report] {result}", "sent", now):
                        break
                else:
                    info = read_manager(manager)
                    results = [r for r in allresults if r.stat().st_mtime > info.get("started", 0)]
                    if results and is_done(results[-1]) and not (info.get("standing") or info.get("keep") or info.get("closed")):
                        self.close(manager)
                        continue
                    pane = info["pane_id"]
                    if pane in self.state["exited"] or info.get("closed"):
                        continue
                    panes = pane_states() if panes is None else panes
                    if panes is None:
                        continue
                    done = bool(results) and is_done(results[-1])
                    standing = bool(info.get("standing"))
                    kept = bool(info.get("keep"))
                    longlived = standing or kept
                    if longlived and pane in panes:
                        self.note_work(pane, panes[pane], len(results))
                    if standing and not kept and done and str(results[-1]) not in self.state["cleared"] and panes.get(pane) in IDLE_STATES:
                        if self.deliver(str(results[-1]), pane, "/clear", "cleared", now):
                            self.worked.pop(pane, None)
                            self.clearing.add(pane)
                    resumed = longlived and self.worked.get(pane) == len(results)
                    if done and not resumed:
                        continue
                    if pane not in panes:
                        self.deliver(pane, coordinator, f"[worker-report] {manager.name} exited without a report", "exited", now)
                    elif stuck_due:
                        self.check_stuck(manager, info, pane, panes[pane], coordinator, now)
        if stuck_due and panes is not None:
            gone = [p for p in self.state["stuck"] if p not in panes]
            for pane in gone:
                del self.state["stuck"][pane]
            self.prompt_since = {p: t for p, t in self.prompt_since.items() if p in panes}
            if gone:
                write_atomic(self.state_file, json.dumps(self.state))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="herdr-report-watch")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=float, default=3.0)
    args = parser.parse_args(argv)
    watcher = Watcher(reports_root())
    while True:
        watcher.scan(time.monotonic())
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
