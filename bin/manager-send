#!/usr/bin/env python3
"""Usage: manager-send <name> "<text>"

The coordinator's way to message its own manager: submits `[coordinator] <text>` to the manager's pane with
`herdr agent prompt`, retrying every 15 seconds (MANAGER_SEND_RETRY_SECONDS) for up to 10 minutes while the
manager is blocked. A `/build` job (`/build <plan.md> node <id> worktree <path>`) first writes `<path>/.owns` from the plan. A standing manager (not kept) is sent to only while its pane is idle; if its newest report is
`Status: done` and not yet cleared, `/clear` is sent first and recorded in the watcher state. A slash-command job
(a new start) while `usage-gate` is parked is not sent: it is saved under `parked` in the watcher state, which resumes
it after the reset, and one line `parked until <time>` is printed.
"""
import json
import os
import re
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from herdr_reports import IDLE_STATES, ReportsError, is_done, manager_folder, pane_states, read_manager, reports_root, write_atomic  # noqa: E402

usage_gate = SourceFileLoader("usage_gate", str(Path(__file__).resolve().parent / "usage-gate")).load_module()

GIVE_UP_SECONDS = 600


def wait_idle(pane: str, deadline: float, interval: float) -> None:
    while True:
        states = pane_states()
        if states is None:
            raise ReportsError("herdr is unreachable")
        if pane not in states:
            raise ReportsError(f"pane {pane} is gone")
        if states[pane] in IDLE_STATES:
            return
        if time.monotonic() + interval > deadline:
            raise ReportsError(f"pane {pane} never went idle")
        time.sleep(interval)


def prompt(pane: str, text: str) -> None:
    done = subprocess.run(["herdr", "agent", "prompt", pane, text], capture_output=True, text=True)
    if done.returncode:
        raise ReportsError((done.stderr.strip() or done.stdout.strip() or f"exit {done.returncode}").splitlines()[0])


def settle_standing(folder: Path, pane: str, deadline: float, interval: float) -> None:
    """Wait for the standing pane to be idle, clearing it first when its done report has not been cleared yet."""
    wait_idle(pane, deadline, interval)
    results = sorted(folder.glob("*.md"))
    state_file = reports_root() / ".watch-state.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    if results and is_done(results[-1]) and str(results[-1]) not in state.get("cleared", []):
        prompt(pane, "/clear")
        state["cleared"] = [*state.get("cleared", []), str(results[-1])]
        write_atomic(state_file, json.dumps(state))
        wait_idle(pane, deadline, interval)


def write_owns(text: str) -> None:
    """Write `<worktree>/.owns` for a `/build` job: node id, Owns paths and the plan's Decided, Standing and Not-building lines."""
    if not text.startswith("/build"):
        return
    fields = {
        "plan": re.search(r"\S+\.md\b", text),
        "node": re.search(r"\bnode[: ]\s*(\w+)", text),
        "worktree": re.search(r"\bworktree[: ]\s*(\S+)", text),
    }
    missing = [name for name, found in fields.items() if not found]
    if missing:
        raise ReportsError(f"/build job names no {', '.join(missing)}")
    plan = Path(fields["plan"].group(0)).expanduser()
    tree = Path(fields["worktree"].group(1)).expanduser()
    node = fields["node"].group(1)
    if not plan.is_file() or not tree.is_dir():
        raise ReportsError(f"plan {plan} or worktree {tree} does not exist")
    note = plan.read_text()
    row = re.search(rf"^\|\s*{re.escape(node)}\b[^\n]*", note, re.M)
    if not row:
        raise ReportsError(f"node {node} is not in {plan}")
    cells = row.group(0).split("|")
    owns = re.findall(r"`([^`]+)`", cells[4] if len(cells) > 4 else "")
    lines = re.findall(r"^- ((?:Decided|Standing|Not-building): .+)$", note, re.M)
    kinds = {line.split(":", 1)[0] for line in lines}
    absent = {"Decided", "Standing", "Not-building"} - kinds
    if not owns:
        raise ReportsError(f"{plan} lists no Owns for {node}")
    if absent:
        raise ReportsError(f"{plan} has no {', '.join(sorted(absent))} line")
    legacy = ["legacy: true"] if re.search(r"^- size:.*\blegacy: true", note, re.M) else []
    write_atomic(tree / ".owns", "\n".join([f"node: {node}", f"owns: {', '.join(owns)}", *lines, *legacy]) + "\n")


def park(folder: Path, text: str, until: float) -> None:
    state_file = reports_root() / ".watch-state.json"
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    state["parked"] = [*state.get("parked", []), {"folder": str(folder), "text": text, "until": until}]
    write_atomic(state_file, json.dumps(state))
    print(f"parked until {time.strftime('%Y-%m-%d %H:%M', time.localtime(until))}")


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    name, text = argv
    interval = float(os.environ.get("MANAGER_SEND_RETRY_SECONDS", "15"))
    try:
        folder = manager_folder(name)
        info = read_manager(folder)
        if info.get("closed"):
            raise ReportsError(f"manager {name!r} is closed")
        write_owns(text)
    except ReportsError as err:
        print(f"manager-send: {err}", file=sys.stderr)
        return 2
    until = usage_gate.parked_until() if text.startswith("/") else None
    if until is not None:
        park(folder, text, until)
        return 0
    deadline = time.monotonic() + GIVE_UP_SECONDS
    if info.get("standing") and not info.get("keep"):
        try:
            settle_standing(folder, info["pane_id"], deadline, interval)
        except ReportsError as err:
            print(f"manager-send: {name}: {err}", file=sys.stderr)
            return 1
    while True:
        done = subprocess.run(["herdr", "agent", "prompt", info["pane_id"], f"[coordinator] {text}"], capture_output=True, text=True)
        if done.returncode == 0:
            return 0
        error = (done.stderr.strip() or done.stdout.strip() or f"exit {done.returncode}").splitlines()[0]
        if time.monotonic() + interval > deadline:
            print(f"manager-send: gave up on {name}: {error}", file=sys.stderr)
            return 1
        time.sleep(interval)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
